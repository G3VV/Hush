# Hush configuration.
#
# Copy this file to `.env` in the same directory and fill in what you need:
#
#     cp .env.example .env
#
# Every line is optional — Hush runs with no .env at all. A real environment
# variable always beats the file, so you can still override per run:
#
#     HUSH_PORT=9000 python3 -m hush.server
#
# `.env` is gitignored. Keep real tokens out of any file that isn't.

# --- Rail (Realtime Trains) --------------------------------------------------
# Sign up at https://api-portal.rtt.io. You are issued a long-life *refresh*
# token; Hush exchanges it for short-life access tokens as needed.
# Without this, rail is skipped and everything else still works.
#
# RTT's terms require this token stays server-side and never reaches a browser.
# Do not paste it into any file that gets committed or shipped to a client.
HUSH_RTT_TOKEN=

# Set to 0 to skip rail even when a token is present.
#HUSH_RAIL=1
# Seconds between rail polls. One request per station per cycle (~19 stations),
# against limits of 30/minute and 750/hour.
#HUSH_RAIL_INTERVAL=300

# --- Server ------------------------------------------------------------------
#HUSH_PORT=8000
# Use 0.0.0.0 to reach the dashboard from another machine on your network.
#HUSH_HOST=127.0.0.1

# --- Scooters (Dott GBFS) ----------------------------------------------------
# Any Dott city slug: bristol, nottingham, milton-keynes, ...
#HUSH_CITY=bristol
#HUSH_POLL_INTERVAL=60
#HUSH_DB=data/hush.db
# How long retired vehicle IDs are kept before pruning.
#HUSH_RETAIN_DAYS=7

# --- Buses (DfT Bus Open Data Service) ---------------------------------------
# No API key needed. Set to 0 to skip buses entirely.
#HUSH_TRANSIT=1
# The national feed is ~2 MB per fetch, hence the slower default.
#HUSH_TRANSIT_INTERVAL=120
# Drop bus positions older than this many seconds (operators leave dead
# vehicles in the feed for hours).
#HUSH_TRANSIT_MAX_AGE=900

# --- Area --------------------------------------------------------------------
# Bounding box for buses and infrastructure. Defaults to Greater Bristol.
#HUSH_BBOX_MIN_LAT=51.38
#HUSH_BBOX_MIN_LON=-2.75
#HUSH_BBOX_MAX_LAT=51.55
#HUSH_BBOX_MAX_LON=-2.45
